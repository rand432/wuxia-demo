static func get_curio(id: String) -> Dictionary:
	return CURIOS.get(id, {})

static func order() -> Array:
	return ORDER

static func level_text(id: String, lv: int) -> String:
	var c := get_curio(id)
	if c.is_empty():
		return ""
	var arr: Array = c.get("lv", [])
	if lv < 1 or lv > arr.size():
		return ""
	return str(arr[lv - 1])
