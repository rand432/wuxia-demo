# 天赋（名/说明/fx/五问池）全部在 shared/data_talents.gd —— 唯一真源。
const DataTalents := preload("res://shared/data_talents.gd")

# 转发壳：真身在 data_talents（v3 起连池子也搬过去了）。
static func pick_talent(aff: String, used: Array) -> Dictionary:
	return DataTalents.pick_for_affinity(aff, used)

static func talent_desc(nm: String) -> String:
	return DataTalents.desc_of(nm)
